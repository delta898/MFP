# Copy this file to .env.trends-api.development in the same directory.
# Keep the copied file only on the Development server. It is ignored by Git.

SUPABASE_SECRET_KEY=
TRENDS_API_TOKEN=
TRENDS_READ_TOKEN_SECRET=

# Public collision fence. This must identify Production Supabase but must never
# contain a Production secret key.
TRENDS_PRODUCTION_SUPABASE_URL=https://<production-project-ref>.supabase.co
