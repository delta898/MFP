{
  "name": "@bloggenius/hello-world",
  "version": "0.1.0",
  "description": "Reference Core Plugin for BlogGenius Plugin discovery and execution.",
  "main": "index.js",
  "files": [
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bloggeniusPlugin": {
    "manifestVersion": 1,
    "id": "hello-world",
    "name": "Hello World",
    "hostApi": "^1.0.0",
    "summary": "A small reference Plugin for trying the BlogGenius Plugin Host.",
    "operations": {
      "hello.say": {
        "description": "Return a friendly greeting.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1, "pattern": "\\S" }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "message": { "type": "string", "minLength": 1, "pattern": "\\S" }
          },
          "required": ["message"],
          "additionalProperties": false
        },
        "capabilities": []
      }
    }
  }
}
