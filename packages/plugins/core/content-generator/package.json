{
  "name": "@bloggenius/content-generator",
  "version": "0.1.0",
  "description": "Provider-neutral text generation Plugin implementing the BlogGenius Plugin descriptor contract",
  "main": "index.js",
  "files": [
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bloggeniusPlugin": {
    "manifestVersion": 1,
    "id": "content-generator",
    "name": "Content Generator",
    "hostApi": "^1.0.0",
    "summary": "Provider-neutral text generation operation.",
    "operations": {
      "text.generate": {
        "description": "Generate text from a prompt using the host-selected text generation provider.",
        "inputSchema": {
          "type": "object",
          "properties": { "prompt": { "type": "string", "minLength": 1, "pattern": "\\S" } },
          "required": ["prompt"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": { "text": { "type": "string", "minLength": 1, "pattern": "\\S" } },
          "required": ["text"],
          "additionalProperties": false
        },
        "capabilities": ["ai.transport"]
      }
    }
  }
}
