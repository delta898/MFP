{
  "name": "@bloggenius/wordpress-publisher",
  "version": "0.1.0",
  "description": "WordPress REST API adapter implementing the BlogGenius Plugin descriptor contract",
  "main": "index.js",
  "files": [
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bloggeniusPlugin": {
    "manifestVersion": 1,
    "id": "wordpress-publisher",
    "name": "WordPress Publisher",
    "hostApi": "^1.0.0",
    "summary": "Publishes posts and uploads media through the WordPress REST API.",
    "operations": {
      "media.upload": {
        "description": "Upload an image asset to the WordPress media library.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "bytesBase64": {
              "type": "string",
              "minLength": 4,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "contentEncoding": "base64"
            },
            "filename": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "mimeType": { "type": "string", "pattern": "^image/[^\\s]+$" },
            "altText": { "type": "string" }
          },
          "required": ["bytesBase64", "filename", "mimeType"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": ["integer", "string"] },
            "url": { "type": "string", "pattern": "^https?://" }
          },
          "required": ["id", "url"],
          "additionalProperties": false
        },
        "capabilities": ["wordpress.credentials", "network.wordpress"]
      },
      "categories.list": {
        "description": "List WordPress categories, optionally filtered by search text.",
        "inputSchema": {
          "type": "object",
          "properties": { "search": { "type": "string" } },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "slug": { "type": "string" }
            },
            "required": ["id", "name", "slug"],
            "additionalProperties": false
          }
        },
        "capabilities": ["wordpress.credentials", "network.wordpress"]
      },
      "posts.create": {
        "description": "Create a WordPress post using WordPress REST API fields.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "content": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "status": { "enum": ["draft", "publish", "future", "pending", "private"] },
            "categories": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
            "featuredMedia": { "type": ["integer", "null"], "minimum": 1 },
            "date": { "type": "string", "minLength": 1 }
          },
          "required": ["title", "content", "status", "categories", "featuredMedia"],
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "future" } }, "required": ["status"] },
              "then": { "required": ["date"] }
            }
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": ["integer", "string"] },
            "url": { "type": "string", "pattern": "^https?://" }
          },
          "required": ["id", "url"],
          "additionalProperties": false
        },
        "capabilities": ["wordpress.credentials", "network.wordpress"]
      }
    }
  }
}
