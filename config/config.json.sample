  "knowledge": {
    "providers": [
      {
        "id": "trends-main",
        "kind": "trends",
        "transport": "builtin_api",
        "enabled": false,
        "label": "SerpApi Trends",
        "config": {
          "vendor": "serpapi",
          "api_key": "",
          "geo": "KR",
          "hl": "ko",
          "hours": 24,
          "limit": 10,
          "only_active": true
        }
      }
    ],
    "routing": {
      "suggestions": [
        "trends-main"
      ],
      "content_ideas": [
        "trends-main"
      ]
    }
  },
  "platforms": {
    "naver": {
      "user_id": "",
      "typing_speed": "QUICK",
      "close_delay_seconds": 3,
      "browser_channel": "auto",
      "assets": {
        "ftc_image": "./config/images/ftc_disclosure.jpeg",
        "cta_images": [
          "./config/images/shopping_cta_1.jpeg",
          "./config/images/shopping_cta_2.jpeg",
