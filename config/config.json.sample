{
  "general": {
    "google_sheet_url": "",
    "listen_host": "127.0.0.1",
    "listen_port": 4577,
    "workspace_dir": "./workspace"
  },
  "content": {
    "blog": {
      "writing_style": {
        "writing_mode": "conversational",
        "speech_level": "polite"
      },
      "writing_strategy": "search"
    },
    "card_news": {
      "builtin_sources": ["naver", "wordpress"],
      "rss_sources": []
    }
  },
  "ai_settings": {
    "TEXT_MODEL": {
      "provider": "gemini",
      "code": "gemini-3.1-flash-lite",
      "api_key": ""
    },
    "IMAGE_MODEL": {
      "provider": "gemini",
      "code": "gemini-3.1-flash-image",
      "api_key": ""
    },
    "image_style": "photorealistic",
    "CHAT_MODEL": {
      "source": "writing",
      "selection": null
    },
    "MODEL_PROFILES": {
      "text": {},
      "image": {},
      "chat": {}
    }
  },
  "knowledge": {
    "providers": [
      {
        "id": "naver-trends",
        "kind": "trends",
        "transport": "builtin_api",
        "enabled": true,
        "label": "Naver Trend Posting",
        "config": {
          "vendor": "naver_trend_posting",
          "categories": [],
          "limit": 10
        }
      },
      {
        "id": "trends-main",
        "kind": "trends",
        "transport": "builtin_api",
        "enabled": false,
        "label": "SerpApi Trends",
        "config": {
          "vendor": "serpapi",
          "api_key": "",
          "geo": "KR",
          "hl": "ko",
          "hours": 24,
          "limit": 10,
          "only_active": true
        }
      }
    ],
    "routing": {
      "suggestions": [
        "trends-main"
      ],
      "content_ideas": [
        "naver-trends",
        "trends-main"
      ]
    }
  },
  "recommendations": {
    "delivery": {
      "enabled": true,
      "refresh_interval_min": 240,
      "startup_delay_ms": 0
    }
  },
  "integrations": {
    "buffer": {
      "api_key": "",
      "organization_id": "",
      "channels": [],
      "help_url": ""
    }
  },
  "platforms": {
    "naver": {
      "user_id": "",
      "typing_speed": "QUICK",
      "close_delay_seconds": 3,
      "browser_channel": "auto",
      "assets": {
        "ftc_image": "./config/images/ftc_disclosure.jpeg",
        "cta_images": [
          "./config/images/shopping_cta_1.jpeg",
          "./config/images/shopping_cta_2.jpeg",
          "./config/images/shopping_cta_3.jpeg"
        ]
      }
    },
    "wordpress": {
      "url": "",
      "user_id": "",
      "app_password": "",
      "assets": {
        "ftc_image": "",
        "cta_images": [
          "",
          "",
          ""
        ]
      }
    }
  },
  "automation": {
    "collect": {
      "blog": {
        "trends": {
          "enabled": false,
          "time": "07:30",
          "categories": "",
          "reuse_gap_days": 21,
          "filters": {
            "min_increase": 30,
            "include_new": false,
            "include_dash": false,
            "include_number": true,
            "type": "top",
            "top_n": 5
          },
          "naver_category": "",
          "wordpress_category": ""
        },
        "rss": {
          "enabled": false,
          "feeds": [
            {
              "enabled": false,
              "url": "",
              "interval": 60,
              "includeKeywords": [],
              "excludeKeywords": [],
              "naver_category": "",
              "wordpress_category": ""
            }
          ]
        }
      }
    },
    "publish": {
      "blog": {
        "enabled": false,
        "interval_min": 60,
        "batch_size": 1,
        "post_status": "publish",
        "target_channels": [
        ],
        "headless": true,
        "image_mode": "generate",
        "notify_enabled": false,
        "start_time": "00:00",
        "end_time": "23:59"
      },
      "shopping": {
        "enabled": false,
        "interval_min": 60,
        "batch_size": 1,
        "target_channels": [
        ],
        "headless": true,
        "notify_enabled": false,
        "start_time": "00:00",
        "end_time": "23:59"
      },
      "social": {
        "enabled": false,
        "interval_min": 10,
        "ai_mode": "none",
        "sheet_name": "SNS",
        "source_blogs": [
          "naver",
          "wordpress"
        ]
      }
    }
  },
  "publish": {
    "image_optimization_enabled": true
  },
  "system": {
    "update_channel": "stable",
    "update_server_type": "github",
    "custom_update_check_url": "",
    "update_mirror_repo": "delta898/NaverAutoBlog-Releases"
  },
  "notification": {
    "telegram": {
      "enabled": false,
      "bot_token": "",
      "chat_id": "",
      "bitly_token": ""
    },
    "slack": {
      "enabled": false,
      "webhook_url": ""
    }
  },
  "features": {
    "naver": {
      "comment_draft": {
        "ai_mode": "default",
        "fetch_limit": 10,
        "tone": "empathetic",
        "max_chars": 60,
        "headless": true
      }
    }
  }
}
