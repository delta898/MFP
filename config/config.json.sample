          ""
        ]
      }
    }
  },
  "automation": {
    "collect": {
      "blog": {
        "trends": {
          "enabled": false,
          "time": "07:30",
          "categories": "",
          "reuse_gap_days": 21,
          "filters": {
            "min_increase": 30,
            "include_new": false,
            "include_dash": false,
            "include_number": true,
            "type": "top",
            "top_n": 5
          },
          "naver_category": "",
          "wordpress_category": ""
        },
        "rss": {
          "enabled": false,
          "feeds": [
            {
              "enabled": false,
              "url": "",
              "interval": 60,
              "includeKeywords": [],
              "excludeKeywords": [],
              "naver_category": "",
              "wordpress_category": ""
            }
          ]
        }
      }
    },
    "publish": {
      "blog": {
        "enabled": false,
        "interval_min": 60,
        "batch_size": 1,
        "target_channels": [
        ],
        "headless": true,
        "notify_enabled": false,
        "start_time": "00:00",
        "end_time": "23:59"
      },
      "shopping": {
        "enabled": false,
        "interval_min": 60,
        "batch_size": 1,
        "target_channels": [
        ],
        "headless": true,
        "notify_enabled": false,
        "start_time": "00:00",
        "end_time": "23:59"
      }
    }
  },
  "publish": {
    "image_optimization_enabled": true
  },
  "system": {
    "update_channel": "stable",
    "update_server_type": "github",
    "custom_update_check_url": "",
    "update_mirror_repo": "delta898/NaverAutoBlog-Releases"
  },
  "notification": {
    "telegram": {
      "enabled": false,
      "bot_token": "",
      "chat_id": "",
      "bitly_token": "",
      "chat_ai_mode": "default"
    },
    "slack": {
      "enabled": false,
      "webhook_url": ""
    }
  },
  "features": {
    "naver": {
      "comment_draft": {
        "ai_mode": "default",
        "fetch_limit": 10,
        "tone": "empathetic",
        "max_chars": 60,
        "headless": true
      }
    }
  }
