# =======================================================
# 🧞‍♂️ BlogGenius 설정 파일
# =======================================================

# [필수] 네이버 아이디
NAVER_ID = 본인의_네이버_아이디

# [옵션] 네이버 검색 API (연관검색어/블로그검색용)
NAVER_CLIENT_ID = 발급받은_Client_ID
NAVER_CLIENT_SECRET = 발급받은_Client_Secret

# [필수] 라이선스 키
LICENSE_KEY = YOUR_LICENSE_KEY_HERE

# [필수] Gemini API 키
GEMINI_API_KEY = YOUR_GEMINI_API_KEY_HERE

# -------------------------------------------------------
# [데이터 소스 설정]
# EXCEL : 기존 로컬 xlsx 파일 사용
# GOOGLE : 구글 스프레드시트 사용
DATA_SOURCE = EXCEL

# [구글 스프레드시트 설정] (DATA_SOURCE = GOOGLE 일 때 필수)
# 1. 서비스 계정 키 파일 경로 (프로젝트 루트 기준)
GOOGLE_AUTH_JSON = ./config/service_account.json

# 2. 스프레드시트 ID (URL 중간의 긴 문자열)
GOOGLE_SHEET_ID = 여기에_구글시트_ID_입력

# 3-1. 키워드 시트 이름 (연관 키워드 추출용)
GOOGLE_KEYWORDS_SHEET = keywords

# 3-2. 주제 시트 이름 (블로그 발행용)
GOOGLE_TOPICS_SHEET = topics


# -------------------------------------------------------
# [AI 모델 설정]
# 기본값으로 두셔도 무방하며, 특정 모델을 원할 때만 수정하세요.

# 텍스트 생성 모델 (기본: gemini-3-flash-preview)
TEXT_MODEL = gemini-3-flash-preview

# 이미지 생성 모델 (기본: gemini-2.5-flash-image)
# 나노바나나 Pro로 하시려면 gemini-3-pro-image-preview
IMAGE_MODEL = gemini-2.5-flash-image

# [옵션] 상세 동작 설정
# -------------------------------------------------------
# 기본 이미지 스타일 (개별 작업에 스타일이 없을 때 사용됨)
# 예: photorealistic, anime style, oil painting, cinematic, 3d render, automatic 등등
IMAGE_STYLE = photorealistic

# -------------------------------------------------------
# [브라우저 설정]
# chrome : 구글 크롬 (추천)
# msedge : 엣지 브라우저
# auto   : 자동 감지
BROWSER_CHANNEL = chrome

# 브라우저 화면 숨기기 (true: 안보임 / false: 보임)
HEADLESS = false

# [옵션] 브라우저 해상도 설정
# 화면이 잘려 보인다면 1440, 900 또는 1280, 800으로 낮춰보세요.
VIEWPORT_WIDTH = 1440
VIEWPORT_HEIGHT = 1024

# -------------------------------------------------------
# [동작 설정]

# 타이핑 속도 (FAST / NORMAL / HUMAN)
# - NORMAL 권장 (너무 빠르면 누락될 수 있음)
TYPING_SPEED = FAST

# 배치 발행 간격 (초 단위)
BATCH_INTERVAL_SECONDS = 10

# 글 작성 완료 후 브라우저가 자동으로 닫히는 대기 시간 (초 단위)
# 0으로 설정하면 자동으로 닫히지 않게 됩니다.
CLOSE_DELAY_SECONDS = 5

# 로그 레벨 (info / debug)
LOG_LEVEL = info
