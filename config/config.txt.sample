# =======================================================
# BlogGenius 설정 파일
# =======================================================

# -------------------------------------------------------
# [도전인생의 100% 완전 자동화 블로깅 오픈채팅방](https://open.kakao.com/o/gZWL25Zh)
# -------------------------------------------------------

# -------------------------------------------------------
# 1) 필수 입력 (처음 세팅 시 반드시 입력)
# -------------------------------------------------------

# [필수] 네이버 아이디
NAVER_ID = 본인의_네이버_아이디

# [필수] Gemini API 키
GEMINI_API_KEY = YOUR_GEMINI_API_KEY_HERE

# [필수] 구글 스프레드시트 인증/대상
GOOGLE_AUTH_JSON = ./config/service_account.json
GOOGLE_SHEET_URL = https://docs.google.com/spreadsheets/d/여기에_구글시트_URL_전체

# UI 서버 바인딩 주소/포트
# LISTEN_HOST = 127.0.0.1  (로컬 전용)
# LISTEN_HOST = 0.0.0.0    (동일 네트워크 접근 허용)
LISTEN_HOST = 127.0.0.1
LISTEN_PORT = 4577

# -------------------------------------------------------
# 2) 쇼핑 포스팅 핵심 설정 (자주 조정)
# -------------------------------------------------------

# 공정위 이미지 소스 (https:// 또는 로컬 파일 경로)
# 기본값은 패키지 기본 이미지(로컬 경로)입니다.
FTC_DISCLOSURE_IMAGE_URL = ./config/images/ftc_disclosure.jpeg

# 구매 독려 이미지 1~3 소스 (https:// 또는 로컬 파일 경로)
# 1은 필수, 2~3은 옵션
SHOPPING_CTA_IMAGE_URL1 = ./config/images/shopping_cta_1.jpeg
SHOPPING_CTA_IMAGE_URL2 = ./config/images/shopping_cta_2.jpeg
SHOPPING_CTA_IMAGE_URL3 = ./config/images/shopping_cta_3.jpeg

# 본문 내 상품 URL 삽입 횟수 (기본 3회)
SHOPPING_LINK_INSERT_COUNT = 3

# 상품 페이지에서 가져올 이미지 최대 개수 (기본 5장)
SHOPPING_IMAGE_MAX_COUNT = 5

# CTA 이미지 삽입 횟수 (기본 2회, 0이면 비활성화)
SHOPPING_CTA_IMAGE_INSERT_COUNT = 2

# -------------------------------------------------------
# 3) 실행 제어 (운영 중 자주 조정)
# -------------------------------------------------------

# [수동 모드] 명령 1회 실행 시 최대 처리 포스트 수
# (batch/shopping 수동 실행 기준)
MAX_BLOG_POSTS_PER_RUN = 5
MAX_SHOPPING_POSTS_PER_RUN = 5

# [네이버 블로그 Auto Mode] (PoC: 현재는 설정 저장만 지원)
NAVER_AUTO_MODE = false
NAVER_AUTO_CATEGORIES =
NAVER_AUTO_DAILY_POSTS = 3
NAVER_AUTO_TRENDS_TIME = 07:30
NAVER_AUTO_PUBLISH_TIME = 08:00
NAVER_AUTO_NOTIFY_ENABLED = true

# 배치 발행 간격 (초, 수동 batch 내부 처리 간격)
BATCH_INTERVAL_SECONDS = 5

# 글 작성 완료 후 브라우저 자동 종료 대기 시간 (초)
# 0이면 자동으로 닫지 않음
CLOSE_DELAY_SECONDS = 5

# 브라우저 화면 숨기기 (true: 숨김 / false: 표시)
HEADLESS = false

# 타이핑 속도 (QUICK / FAST / NORMAL / HUMAN)
TYPING_SPEED = FAST


# -------------------------------------------------------
# 4) AI 모델/브라우저 설정 (필요할 때만 수정)
# -------------------------------------------------------

# 텍스트 생성 모델
TEXT_MODEL = gemini-3-flash-preview

# 이미지 생성 모델
# 나노바나나 Pro를 쓰려면 gemini-3-pro-image-preview
IMAGE_MODEL = gemini-2.5-flash-image

# 기본 이미지 스타일
IMAGE_STYLE = photorealistic

# 브라우저 채널 (chrome / msedge / auto)
BROWSER_CHANNEL = chrome

# 브라우저 해상도
VIEWPORT_WIDTH = 1440
VIEWPORT_HEIGHT = 1024
