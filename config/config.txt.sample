# =======================================================
# BlogGenius 설정 파일
# =======================================================

# -------------------------------------------------------
# 1) 필수 입력 (처음 세팅 시 반드시 입력)
# -------------------------------------------------------

# [필수] 네이버 아이디
NAVER_ID = 본인의_네이버_아이디

# [필수] 라이선스 키 (기본값: test)
# - 비워두거나 test로 두면 테스트 플랜 정책으로 동작
# - free로 두면 무료 플랜 정책으로 동작
# - 유료/구독 전환 시 발급받은 키로 변경
LICENSE_KEY = test

# [필수] Gemini API 키
GEMINI_API_KEY = YOUR_GEMINI_API_KEY_HERE

# [필수] 구글 스프레드시트 인증/대상
GOOGLE_AUTH_JSON = ./config/service_account.json
GOOGLE_SHEET_ID = 여기에_구글시트_ID_입력

# -------------------------------------------------------
# 2) 쇼핑 포스팅 핵심 설정 (자주 조정)
# -------------------------------------------------------

# 공정위 안내 이미지 URL (쇼핑 포스팅 상단에 삽입)
# 추후 본인의 이미지로 대체 필요
FTC_DISCLOSURE_IMAGE_URL = https://buly.kr/5JOadbF

# CTA 이미지 URL 1~3 (1은 필수, 2~3은 옵션)
# 추후 본인의 이미지로 대체 필요
SHOPPING_CTA_IMAGE_URL1 = https://buly.kr/ChqPpmp
SHOPPING_CTA_IMAGE_URL2 = https://buly.kr/BpGcviH
SHOPPING_CTA_IMAGE_URL3 = https://buly.kr/EI5Ef8f

# 본문 내 상품 URL 삽입 횟수 (기본 3회)
SHOPPING_LINK_INSERT_COUNT = 3

# 상품 페이지에서 가져올 이미지 최대 개수 (기본 5장)
SHOPPING_IMAGE_MAX_COUNT = 5

# CTA 이미지 삽입 횟수 (기본 2회, 0이면 비활성화)
SHOPPING_CTA_IMAGE_INSERT_COUNT = 2

# 프롬프트 오버라이드(선택):
# - ./config/blog_prompt.md 가 있으면 블로그 기본 프롬프트 대신 사용
# - ./config/shopping_prompt.md 가 있으면 쇼핑 기본 프롬프트 대신 사용

# -------------------------------------------------------
# 3) 실행 제어 (운영 중 자주 조정)
# -------------------------------------------------------

# 배치(blog) 실행 1회당 최대 처리 포스트 수
# 0이면 무제한, 미설정/음수는 기본 5
MAX_BLOG_POSTS_PER_RUN = 5

# 쇼핑(shopping) 실행 1회당 최대 처리 포스트 수
# 0이면 무제한, 미설정/음수는 기본 5
MAX_SHOPPING_POSTS_PER_RUN = 5

# 배치 발행 간격 (초)
BATCH_INTERVAL_SECONDS = 5

# 글 작성 완료 후 브라우저 자동 종료 대기 시간 (초)
# 0이면 자동으로 닫지 않음
CLOSE_DELAY_SECONDS = 5

# 브라우저 화면 숨기기 (true: 숨김 / false: 표시)
HEADLESS = false

# 타이핑 속도 (QUICK / FAST / NORMAL / HUMAN)
TYPING_SPEED = FAST


# -------------------------------------------------------
# 4) AI 모델/브라우저 설정 (필요할 때만 수정)
# -------------------------------------------------------

# 텍스트 생성 모델
TEXT_MODEL = gemini-3-flash-preview

# 이미지 생성 모델
# 나노바나나 Pro를 쓰려면 gemini-3-pro-image-preview
IMAGE_MODEL = gemini-2.5-flash-image

# 기본 이미지 스타일
IMAGE_STYLE = photorealistic

# 브라우저 채널 (chrome / msedge / auto)
BROWSER_CHANNEL = chrome

# 브라우저 해상도
VIEWPORT_WIDTH = 1440
VIEWPORT_HEIGHT = 1024
