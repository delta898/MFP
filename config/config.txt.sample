# =======================================================
# BlogGenius 설정 파일
# =======================================================

# -------------------------------------------------------
# [도전인생의 100% 완전 자동화 블로깅 오픈채팅방](https://open.kakao.com/o/gZWL25Zh)
# -------------------------------------------------------

# -------------------------------------------------------
# 1) 필수 입력 (처음 세팅 시 반드시 입력)
# -------------------------------------------------------

# [필수] 네이버 아이디
NAVER_ID = 

# [필수] Gemini API 키
GEMINI_API_KEY = 

# [필수] 구글 스프레드시트 인증/대상
GOOGLE_AUTH_JSON = ./config/service_account.json
GOOGLE_SHEET_URL = 

# UI 서버 바인딩 주소/포트
LISTEN_HOST = 127.0.0.1
LISTEN_PORT = 4577

# -------------------------------------------------------
# 2) 워드프레스 설정 (선택)
# -------------------------------------------------------
WORDPRESS_URL = 
WORDPRESS_USER_ID = 
WORDPRESS_APP_PASSWORD = 

# -------------------------------------------------------
# 3) 자동 발행 설정 (Auto Mode)
# -------------------------------------------------------

# [블로그 자동발행]
BLOG_AUTO_MODE = false
BLOG_AUTO_CATEGORIES = 
BLOG_AUTO_MAX_POSTS_PER_RUN = 10
BLOG_AUTO_TRENDS_TIME = 07:30

# [트렌드 자동수집]
COLLECT_TRENDS_ENABLED = false
COLLECT_TRENDS_TIME = 07:30

# [쇼핑 자동발행]
SHOPPING_AUTO_MODE = false
SHOPPING_AUTO_DAILY_POSTS = 10
SHOPPING_AUTO_TIME = 07:50

# [이미지 설정]
# 기본 제공되는 이미지를 사용하거나, 커스텀 이미지(https:// 또는 로컬경로)로 변경 가능합니다.
FTC_DISCLOSURE_IMAGE_URL = ./config/images/ftc_disclosure.jpeg
SHOPPING_CTA_IMAGE_URL1 = ./config/images/shopping_cta_1.jpeg
SHOPPING_CTA_IMAGE_URL2 = ./config/images/shopping_cta_2.jpeg
SHOPPING_CTA_IMAGE_URL3 = ./config/images/shopping_cta_3.jpeg

# -------------------------------------------------------
# ※ 위 설정만으로도 즉시 사용 가능합니다.
# 고급 설정(AI 모델, 이미지 소스 등)은 UI 설정 메뉴에서 변경하거나
# 개발자 가이드를 참고하여 이 파일에 직접 추가할 수 있습니다.
# -------------------------------------------------------
