# Copy these values into the local, ignored .env.development file or your secret manager.
# BlogGenius only uses the public Supabase contract. Infrastructure configuration
# and Edge Function secrets belong to the Supabase environment provider.
BLOGGENIUS_DEVELOPMENT_SUPABASE_PROJECT_NAME=BlogGenius Development
BLOGGENIUS_DEVELOPMENT_SUPABASE_URL=https://supabase.example.com
BLOGGENIUS_DEVELOPMENT_SUPABASE_PUBLISHABLE_KEY=

# Optional cross-check. When configured, development must use a different URL.
BLOGGENIUS_PRODUCTION_SUPABASE_URL=
