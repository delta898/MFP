# Use this schema for repository-root .env.oauth.dev and .env.oauth.prod files.
# Each source launcher reads only its matching environment file.
# Local runtime keeps the existing .env.oauth path for now.
# Never commit the real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_CLIENT_ID=
# Optional: replace BlogGenius' default Cloudflare OAuth scopes for a client.
# Space-delimited scope IDs; configure only scopes granted to the selected client.
# CLOUDFLARE_OAUTH_SCOPES="memberships.read workers-scripts.admin workers-routes.write dns.read zone.read offline_access"
