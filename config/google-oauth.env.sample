# Copy this file to the repository root as .env.oauth on a development computer.
# Local/Development launches load the Cloudflare Client ID from this file too.
# Cloudflare is not yet included in the packaged release build configuration.
# Never commit the real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_CLIENT_ID=
# Optional: replace BlogGenius' default Cloudflare OAuth scopes for a test client.
# Space-delimited scope IDs; configure only scopes granted to the selected client.
# CLOUDFLARE_OAUTH_SCOPES="memberships.read workers-scripts.admin workers-scripts.edit workers-routes.write dns.read zone.read offline_access"
