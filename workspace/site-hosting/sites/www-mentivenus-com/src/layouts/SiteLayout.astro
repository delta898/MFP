---
import '../styles/site.css';

const { title = 'MentiVenus', description = 'MentiVenus 공식 홈페이지' } = Astro.props;
const origin = Astro.site || new URL('https://www-dev.mentivenus.com');
const canonical = new URL(Astro.url.pathname, origin).toString();
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title} | MentiVenus</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="MentiVenus 홈"><span class="wordmark-symbol">M</span><span class="wordmark-name">Menti<span>Venus</span></span></a>
      <nav class="site-nav" aria-label="주요 메뉴">
        <a href="#about">회사소개</a>
        <a href="#work">사업영역</a>
        <a href="#product">제품</a>
      </nav>
      <a class="header-cta" href="https://www.bloggenius.kr/">BlogGenius <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand"><a class="wordmark" href="/" aria-label="MentiVenus 홈"><span class="wordmark-symbol">M</span><span class="wordmark-name">Menti<span>Venus</span></span></a><p>Ideas into useful software.</p></div>
      <div class="footer-links"><a href="#about">회사소개</a><a href="#work">사업영역</a><a href="https://www.bloggenius.kr/">BlogGenius <span aria-hidden="true">↗</span></a></div>
      <div class="footer-legal"><span>기술로 더 나은 일의 흐름을 만듭니다.</span><span>© {new Date().getFullYear()} MentiVenus</span></div>
    </footer>
  </body>
</html>
