---
import '../styles/site.css';

const { title = 'MentiVenus', description = 'MentiVenus 공식 홈페이지' } = Astro.props;
const origin = Astro.site || new URL('https://www-dev.mentivenus.com');
const canonical = new URL(Astro.url.pathname, origin).toString();
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f3" />
    <link rel="canonical" href={canonical} />
    <title>{title} | MentiVenus</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="MentiVenus 홈">Menti<span>Venus</span></a>
      <a class="product-link" href="https://www.bloggenius.kr/">BlogGenius <span aria-hidden="true">↗</span></a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a class="wordmark" href="/">Menti<span>Venus</span></a>
      <p>BlogGenius는 MentiVenus의 제품입니다.</p>
    </footer>
  </body>
</html>
