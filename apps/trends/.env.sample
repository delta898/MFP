# Required
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TRENDS_NAVER_ID=
# Relative paths here are resolved from the repo root.
TRENDS_AUTH_FILE_PATH=./config/naver_auth.json

# Recommended defaults
TRENDS_API_HOST=127.0.0.1
TRENDS_API_PORT=4581
# Required for collector, WordPress, and exports. Keep this separate from read-token secrets.
TRENDS_API_TOKEN=
# Required when exposing read endpoints to desktop users. Must match the Edge Function secret.
TRENDS_READ_TOKEN_SECRET=
TRENDS_HEADLESS=true

# Optional run-time overrides
# TRENDS_TARGET_DATE=2026-04-02
# TRENDS_DRY_RUN=false

# Optional advanced settings
# TRENDS_API_BASE_URL=http://127.0.0.1:4581
# TRENDS_SOURCE=naver_creator_advisor
# TRENDS_BROWSER_CHANNEL=chrome
# TRENDS_BROWSER_WINDOW_SIZE=
# TRENDS_SUPABASE_SCHEMA=trends
# TRENDS_SUPABASE_TABLE=items
# TRENDS_SUPABASE_ON_CONFLICT=source,trend_date,category,keyword
# TRENDS_SUPABASE_META_FUNCTION=get_items_meta
# TRENDS_EXPORT_MAX_ROWS=5000
# TRENDS_META_CACHE_TTL_MS=300000
# TRENDS_API_MAX_CONCURRENT_REQUESTS=8
# TRENDS_API_MAX_BODY_BYTES=1048576
# TRENDS_API_REQUEST_TIMEOUT_MS=30000
# TRENDS_API_UPSTREAM_TIMEOUT_MS=7000
# TRENDS_READ_TOKEN_ISSUER=bloggenius-license
# TRENDS_READ_TOKEN_AUDIENCE=trends-api
# TRENDS_READ_TOKEN_TTL_SECONDS=900
# TRENDS_API_READ_RATE_LIMIT_PER_MINUTE=120

# Legacy fallback only
# SUPABASE_SERVICE_ROLE_KEY=
