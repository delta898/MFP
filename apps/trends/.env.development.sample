TRENDS_ENV=development

SUPABASE_URL=https://<development-project-ref>.supabase.co
SUPABASE_SECRET_KEY=
TRENDS_SUPABASE_TARGET_ENV=development
TRENDS_NAVER_ID=
TRENDS_AUTH_FILE_PATH=./config/naver_auth.json

TRENDS_API_HOST=0.0.0.0
# The server infrastructure decides which host port and HTTPS route map to this
# container service port.
TRENDS_API_PORT=4581
TRENDS_API_BASE_URL=https://trendapi-dev.hangadac.com
TRENDS_API_TARGET_ENV=development
TRENDS_API_TOKEN=
TRENDS_READ_TOKEN_SECRET=
TRENDS_READ_TOKEN_ISSUER=bloggenius-development
TRENDS_READ_TOKEN_AUDIENCE=trends-api-development
TRENDS_HEADLESS=true

# Optional collision fences. Public URLs only; never put secrets here.
TRENDS_PRODUCTION_SUPABASE_URL=https://<production-project-ref>.supabase.co
TRENDS_PRODUCTION_API_BASE_URL=https://trendapi.hangadac.com
