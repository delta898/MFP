# Production Trends Collector configuration
TRENDS_ENV=production

TRENDS_NAVER_ID=
TRENDS_AUTH_FILE_PATH=/absolute/path/to/naver_auth.json

TRENDS_API_BASE_URL=https://trendapi.hangadac.com
TRENDS_API_TARGET_ENV=production
TRENDS_API_TOKEN=
TRENDS_HEADLESS=true
# 실제 write 승인은 collect_production.sh의 interactive 확인 또는
# --confirm-production 옵션이 실행 직전에만 부여합니다.
