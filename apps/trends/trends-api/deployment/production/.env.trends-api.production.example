# Copy this file to .env.trends-api.production in the same directory.
# Keep the copied file only on the Production server. It is ignored by Git.

# Production Supabase project URL. Never point this at Local or Development.
SUPABASE_URL=

# Server-side values. Use the existing Production values; never commit this file.
SUPABASE_SECRET_KEY=
TRENDS_API_TOKEN=
TRENDS_READ_TOKEN_SECRET=
