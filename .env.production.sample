# BlogGenius Production source runtime (public Desktop values only)
# Copy this file to .env.production and fill the values once.

BLOGGENIUS_PRODUCTION_SUPABASE_PROJECT_NAME="BlogGenius Production"
BLOGGENIUS_PRODUCTION_SUPABASE_PROJECT_REF=""
BLOGGENIUS_PRODUCTION_SUPABASE_URL="https://<project-ref>.supabase.co"
BLOGGENIUS_PRODUCTION_SUPABASE_PUBLISHABLE_KEY=""
BLOGGENIUS_PRODUCTION_TRENDS_API_URL="https://trendapi.example.com"

# Google Desktop OAuth is normally loaded from the existing ignored .env.oauth.
# Do not put service-role keys, DB passwords, provider secrets, or Trends server secrets here.
