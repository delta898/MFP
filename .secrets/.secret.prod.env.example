# Copy to .secrets/.secret.prod.env and set permissions with: chmod 600 .secrets/.secret.prod.env
# Values are synced to the GitHub production Environment only. This does not deploy Production.
# CLOUDFLARE_ACCOUNT_ID and NEWSLETTER_CANARY_EMAIL are Environment variables; other values are secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUPABASE_ACCESS_TOKEN=
# Supabase Connect -> Session pooler URI (port 5432); URL-encode special password characters.
SUPABASE_DB_POOLER_URL=
BLOGGENIUS_PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
TRENDS_SUPABASE_SECRET_KEY=
TRENDS_API_TOKEN=
TRENDS_READ_TOKEN_SECRET=
TRENDS_NEWSLETTER_WORKER_TOKEN=
TRENDS_NEWSLETTER_CANARY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BREVO_API_KEY=
NEWSLETTER_EMAIL_FROM=
NEWSLETTER_UNSUBSCRIBE_TOKEN_SECRET=
NEWSLETTER_CANARY_EMAIL=
