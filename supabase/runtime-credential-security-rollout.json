{
  "schema_version": 1,
  "feature": "runtime-credential-security",
  "target": "development",
  "production_mutation_allowed": false,
  "migrations": [
    "202608290000_add_blog_reference_gateway.sql",
    "202608290010_add_shopping_product_gateway.sql",
    "202608290020_harden_public_runtime_config.sql"
  ],
  "edge_functions": [
    {
      "name": "knowledge-gateway",
      "verify_jwt": true,
      "required_secret_names": [
        "NAVER_CLIENT_ID",
        "NAVER_CLIENT_SECRET"
      ]
    }
  ],
  "ordered_phases": [
    "preflight",
    "database_dry_run",
    "database_migrate",
    "function_deploy",
    "safe_http_smoke",
    "semantic_provider_smoke",
    "development_evidence",
    "dev_push"
  ],
  "semantic_smoke": [
    {
      "route": "blog_reference:writing_reference",
      "external_provider_call": true,
      "approval_required": true
    },
    {
      "route": "shopping_product:product_recovery",
      "external_provider_call": true,
      "approval_required": true
    }
  ]
}
