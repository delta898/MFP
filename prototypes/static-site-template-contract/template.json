    "navigation": {
      "type": "navigation",
      "label": "Navigation menu",
      "required": true,
      "maxItems": 8,
      "default": [
        { "label": "About", "href": "/about/" },
        { "label": "Articles", "href": "/articles/" }
      ]
    }
  },
