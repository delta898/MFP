{
  "name": "blog-genius",
  "productName": "BlogGenius",
  "version": "0.6.1",
  "description": "Google Gemini AI 기반 네이버 블로그 자동 포스팅 솔루션",
  "main": "src/host/electron/electron-main.js",
  "scripts": {
    "start": "electron .",
    "editor:prototype": "vite --config prototypes/manuscript-editor/vite.config.mjs --host 127.0.0.1",
    "build:manuscript-editor": "vite build --config prototypes/manuscript-editor/product-editor.vite.config.mjs",
    "test:editor-stage0": "node scripts/test-manuscript-editor-stage0.js",
    "test:manuscript-image-slash": "npm run build:manuscript-editor && node --test scripts/manuscript-image-slash-contract.test.js && node scripts/test-manuscript-image-slash.js",
    "app:local": "node scripts/app-environment-launcher.js local",
    "app:development": "node scripts/app-environment-launcher.js development",
    "app:production": "node scripts/production-app-launcher.js",
    "env:status": "node scripts/environment-status.js",
    "ui": "node src/host/launcher.js",
    "test:ui-blog-auto": "node scripts/test-ui-blog-auto.js",
    "test:ui-settings": "node scripts/test-ui-settings.js",
    "test:ui-e2e": "node scripts/test-ui-e2e.js",
    "test:ui-browser": "node scripts/test-ui-browser-smoke.js",
    "test:chat-model": "node --test src/utils.chat-model.test.js src/ai-model-config.test.js src/capabilities/settings/chat-model.test.js src/applications/sns/generation/sns-ai-service.test.js",
    "test:security": "npm audit --audit-level=high",
    "verify:site-hosting-contract": "node scripts/verify-site-hosting-contract.js",
    "pretest:unit": "npm run test:security",
    "test:unit": "node scripts/run-unit-tests.js",
    "mcp:stdio": "node src/mcp/stdio-server.js",
    "mcp:http": "node src/mcp/http-server.js",
    "trends:collector": "node ./bin/trends-collector",
    "trends:collector:local": "node ./bin/run-trends-tool.js collector --environment local",
    "trends:collector:development": "node ./bin/run-trends-tool.js collector --environment development",
    "trends:collector:production": "node ./bin/run-trends-tool.js collector --environment production",
    "trends:env:status": "node ./bin/trends-env-status",
    "trends:api:local:container-smoke": "node ./scripts/trends-local-container-smoke.js",
    "trends:development:preflight": "node ./scripts/trends-development-preflight.js",
    "trends:production:transition:preflight": "node ./scripts/trends-production-transition-preflight.js",
    "env:preflight": "node scripts/environment-preflight.js check",
    "env:development:ready": "node scripts/hosted-development-readiness.js",
    "env:development:plan": "node scripts/hosted-development-plan.js",
    "credentials:development:plan": "node scripts/runtime-credential-rollout-plan.js",
    "env:development:smoke": "node scripts/hosted-development-smoke.js",
    "env:release:artifact": "node scripts/environment-release-gate.js create",
    "env:release:verify": "node scripts/environment-release-gate.js verify",
    "env:development:evidence": "node scripts/development-deployment-evidence.js",
    "env:development:drift": "node scripts/environment-release-gate.js verify-development",
    "env:production:checklist": "node scripts/environment-release-gate.js production-checklist",
    "env:local:start": "supabase start --exclude realtime,storage-api,imgproxy,studio",
    "env:local:reset": "node scripts/environment-preflight.js check --target local --operation database-reset && supabase db reset --local && node scripts/reset-local-license-file.js",
    "env:local:verify": "supabase db query --local --file supabase/tests/local_baseline.sql",
    "ver:patch": "node scripts/bump-version.js patch",
    "ver:minor": "node scripts/bump-version.js minor",
    "ver:major": "node scripts/bump-version.js major",
    "//": "👇 npm run build 실행 시 build.sh가 실행되도록 연결하면 편합니다.",
    "build": "./build.sh"
  },
  "pkg": {
    "scripts": [
      "src/host/**/*.js",
      "src/config-loader.js",
      "src/license.js",
      "src/core.js",
      "src/utils.js",
      "src/keyword-manager.js",
      "src/shopping-manager.js",
      "src/constants.js",
      "src/auth-session.js",
      "src/ui-server.js",
      "src/telegram-bot.service.js",
      "src/telegram-pairing.service.js",
      "src/insight-engine.js",
      "src/config/**/*.js",
      "src/adapters/**/*.js",
      "src/applications/**/*.js",
      "src/composition/**/*.js",
      "src/platform/**/*.js",
      "src/services/**/*.js",
      "packages/plugins/core/**/*.js",
      "src/site-hosting/**/*.js",
      "src/content/**/*.js",
      "src/environment/**/*.js",
      "src/naver/**/*.js",
      "src/ai/**/*.js",
      "src/utilities/**/*.js",
      "src/keyword-discovery/**/*.js",
      "src/ui-api/**/*.js"
    ],
    "assets": [
      "package.json",
      "packages/plugins/core/**/*",
      "ui/**/*",
      "src/config/*.md",
      "src/config/*.json",
      "node_modules/playwright-core/lib/**/*.js",
      "node_modules/playwright-core/package.json",
      "node_modules/axios/dist/node/axios.cjs",
      "node_modules/cheerio/lib/*.js",
      "node_modules/moment/moment.js",
      "node_modules/moment-timezone/builds/moment-timezone-with-data.js"
    ],
    "//": "👇 targets는 build.sh에서 지정하므로 여기선 기본값으로 둡니다.",
    "targets": [
      "node24-macos-arm64",
      "node24-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "1.0.5",
    "@supabase/supabase-js": "2.117.2",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "cloudflare": "7.2.0",
    "googleapis": "^171.4.0",
    "marked": "^17.0.6",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.4",
    "node-machine-id": "^1.1.12",
    "node-telegram-bot-api": "^1.2.0",
    "npm": "12.2.0",
    "playwright": "1.63.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "amadejjs",
  "license": "Commercial",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "electron": "^44.4.5",
    "vite": "^8.3.1"
  }
}
