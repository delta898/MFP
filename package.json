{
  "name": "blog-genius",
  "version": "0.9.6-dev1",
  "description": "Google Gemini AI 기반 네이버 블로그 자동 포스팅 솔루션",
  "main": "src/gui/electron-main.js",
  "bin": {
    "blog-genius": "./src/main.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node src/main.js",
    "ui": "node src/main.js ui",
    "login": "node src/main.js login",
    "gen": "node src/main.js gen",
    "batch": "node src/main.js batch",
    "keywords": "node src/main.js search",
    "trends": "node src/main.js trends",
    "shopping": "node src/main.js shopping",
    "test:ui-blog-auto": "node scripts/test-ui-blog-auto.js",
    "test:ui-settings": "node scripts/test-ui-settings.js",
    "test:ui-e2e": "node scripts/test-ui-e2e.js",
    "post": "node src/main.js post",
    "kw": "node src/main.js keywords",
    "pub": "node src/main.js pub",
    "ver:patch": "node scripts/bump-version.js patch",
    "ver:minor": "node scripts/bump-version.js minor",
    "ver:major": "node scripts/bump-version.js major",
    "//": "👇 npm run build 실행 시 build.sh가 실행되도록 연결하면 편합니다.",
    "build": "./build.sh"
  },
  "pkg": {
    "scripts": [
      "src/main.js",
      "src/config-loader.js",
      "src/license.js",
      "src/core.js",
      "src/utils.js",
      "src/browser-launcher.js",
      "src/keyword-manager.js",
      "src/trend-manager.js",
      "src/shopping-manager.js",
      "src/logger.js",
      "src/constants.js",
      "src/auth-session.js",
      "src/ui-server.js",
      "src/ui-api/**/*.js"
    ],
    "assets": [
      "package.json",
      "ui/**/*",
      "src/config/*.md",
      "node_modules/playwright-core/lib/**/*.js",
      "node_modules/playwright-core/package.json",
      "node_modules/axios/dist/node/axios.cjs",
      "node_modules/cheerio/lib/*.js",
      "node_modules/moment/moment.js",
      "node_modules/moment-timezone/builds/moment-timezone-with-data.js"
    ],
    "//": "👇 targets는 build.sh에서 지정하므로 여기선 기본값으로 둡니다.",
    "targets": [
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.39.0",
    "axios": "^1.13.6",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "googleapis": "^171.4.0",
    "marked": "^17.0.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "node-machine-id": "^1.1.12",
    "playwright": "1.44.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "amadejjs",
  "license": "Commercial",
  "//": "👇 [필수] GitHub Actions(Node 18)에서도 안정적인 빌드를 위해 추가",
  "overrides": {
    "undici": "6.19.2"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-packager": "^17.1.2"
  }
}